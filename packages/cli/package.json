{
  "name": "@diagram-engine/cli",
  "private": true,
  "version": "0.2.0",
  "description": "diagram / diagram-mcp binaries: CLI commands, MCP stdio server, viewer server, headless SVG export.",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "diagram": "dist/bin/diagram.mjs",
    "diagram-mcp": "dist/bin/diagram-mcp.mjs"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json && node scripts/bundle.mjs"
  },
  "dependencies": {
    "@diagram-engine/core": "0.2.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "commander": "^12.1.0",
    "elkjs": "^0.9.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.5.4",
    "vitest": "^3.0.0"
  }
}
